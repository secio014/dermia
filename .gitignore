# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
*.tgz

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# EAS / store credentials (NUNCA versionar)
credentials.json
google-services.json
GoogleService-Info.plist

# Metro
.metro-health-check*

# debug / logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
logs/

# testes
coverage/

# macOS
.DS_Store
*.pem

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# local env files (segredos: Supabase keys, service_role, etc.)
.env
.env.*
!.env.example
!.env.sample

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Supabase CLI local cache
supabase/.temp/
supabase/.branches/
supabase/.react/
supabase/functions/**/.env

# Netlify (estado local do deploy)
.netlify/

# Scripts com dados reais (clínica/credenciais) — manter só o template
scripts/onboarding-clinica.local.sql
scripts/*.local.sql

# editors
.claude/
.vscode/
.idea/

# Deno / config de editor das Edge Functions (local, não versionar)
supabase/functions/deno.json
supabase/functions/deno.jsonc
supabase/functions/deno.lock
