{
  "expo": {
    "name": "DermIA",
    "slug": "dermia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dermia",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFF5F4",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dermia.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dermia.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFF5F4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "DermIA",
      "shortName": "DermIA",
      "description": "Acompanhamento clínico da evolução de queimaduras e lesões de pele.",
      "lang": "pt-BR",
      "themeColor": "#C81E3A",
      "backgroundColor": "#FFF5F4",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF5F4",
          "dark": {
            "backgroundColor": "#1A0E0D"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O DermIA usa a câmera para fotografar a evolução das lesões."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O DermIA usa a galeria para anexar vídeos e imagens de exercícios.",
          "cameraPermission": "O DermIA usa a câmera para fotografar a evolução das lesões."
        }
      ],
      "expo-sharing",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "befdc688-06b9-4621-9eb7-6b9a9a8a80fa"
      }
    },
    "owner": "schmitz01401",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/befdc688-06b9-4621-9eb7-6b9a9a8a80fa"
    }
  }
}
